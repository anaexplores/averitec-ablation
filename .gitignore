data/train.json
data/dev.json
data/test_side.json
data/tuning_side.json

# Intermediate HTML build artifacts
docs/paper.html
docs/slides.html
docs/figures/fig1_dark_slide.png

# Python bytecode cache
__pycache__/
*.pyc

# Local tool and editor settings
.claude/
.vibecoding/
.vscode/
.idea/

# Secrets
.env
.env.*
!.env.example

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
*.tmp
